{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "SizManager/SizManager.csproj"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "publish-x64",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "SizManager/SizManager.csproj",
        "-c", "Release",
        "-r", "win-x64",
        "--self-contained"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "publish-x86",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "SizManager/SizManager.csproj",
        "-c", "Release",
        "-r", "win-x86",
        "--self-contained"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "run",
      "command": "dotnet",
      "type": "process",
      "args": ["run", "--project", "SizManager/SizManager.csproj"],
      "problemMatcher": "$msCompile"
    }
  ]
}
