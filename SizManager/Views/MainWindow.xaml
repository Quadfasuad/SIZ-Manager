<Window x:Class="SizManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="СИЗ Менеджер"
        Icon="/siz.ico"
        Width="1180" Height="860"
        MinWidth="980" MinHeight="680"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCardCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding Card.SaveCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenEmployeeListCommand}" />
    </Window.InputBindings>

    <Border Margin="10"
            Background="{StaticResource BrushSurface}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="24">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource BrushSurfaceMuted}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,1,0"
                    CornerRadius="24,0,0,24"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Image Source="/Resources/prof_logo.png"
                               Height="150"
                               Stretch="Uniform"
                               Margin="0,0,0,18"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <TextBlock Text="Навигация"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="4,0,0,10" />

                        <Button Command="{Binding ShowCardTabCommand}"
                                Style="{StaticResource SidebarCardTabButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/Icons/nav-card.png"
                                       Style="{StaticResource SidebarIconImage}" />
                                <TextBlock Text="Карточка СИЗ"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowDermatologicalTabCommand}"
                                Style="{StaticResource SidebarDermTabButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/Icons/nav-dermatological.png"
                                       Style="{StaticResource SidebarIconImage}" />
                                <TextBlock Text="Дерматологические СИЗ"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Height="1"
                                Margin="0,12,0,12"
                                Background="{StaticResource BrushBorder}" />

                        <Button Command="{Binding OpenEmployeeListCommand}"
                                Style="{StaticResource SidebarNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/Icons/nav-employees.png"
                                       Style="{StaticResource SidebarIconImage}" />
                                <TextBlock Text="Сотрудники"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenProfessionListCommand}"
                                Style="{StaticResource SidebarNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/Icons/nav-professions.png"
                                       Style="{StaticResource SidebarIconImage}" />
                                <TextBlock Text="Профессии"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ManageBackupsCommand}"
                                Style="{StaticResource SidebarNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/Icons/nav-backups.png"
                                       Style="{StaticResource SidebarIconImage}" />
                                <TextBlock Text="Резервные копии"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CheckUpdateCommand}"
                                Style="{StaticResource SidebarNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/Icons/nav-updates.png"
                                       Style="{StaticResource SidebarIconImage}" />
                                <TextBlock Text="Обновления"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowAboutCommand}"
                                Style="{StaticResource SidebarNavButton}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Resources/Icons/nav-about.png"
                                       Style="{StaticResource SidebarIconImage}" />
                                <TextBlock Text="О программе"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Background="{StaticResource BrushSurface}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="14"
                                Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="СПРАВОЧНИК СИЗ"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />
                                <TextBlock Margin="0,0,0,4">
                                    <Run Text="Профессий в базе: " FontWeight="Bold" />
                                    <Run Text="{Binding ProfessionCount, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="0,0,0,4">
                                    <Run Text="Версия: " />
                                    <Run Text="{Binding DatabaseVersion, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Background="{StaticResource BrushAppBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Menu>
                    <MenuItem Header="Файл">
                        <MenuItem Header="Новая карточка" Command="{Binding NewCardCommand}"
                                  InputGestureText="Ctrl+N" />
                        <MenuItem Header="Открыть карточку..." Command="{Binding OpenEmployeeListCommand}"
                                  InputGestureText="Ctrl+O" />
                        <MenuItem Header="Сохранить" Command="{Binding Card.SaveCommand}"
                                  InputGestureText="Ctrl+S" />
                        <Separator />
                        <MenuItem Header="Экспорт в DOCX..." Command="{Binding Card.ExportDocxCommand}" />
                        <MenuItem Header="Экспорт в PDF..." Command="{Binding Card.ExportPdfCommand}" />
                        <MenuItem Header="Экспорт в Excel..." Command="{Binding Card.ExportExcelCommand}" />
                        <Separator />
                        <MenuItem Header="Выход" Click="MenuItem_Exit_Click" />
                    </MenuItem>
                    <MenuItem Header="Справочник">
                        <MenuItem Header="Импорт справочника из JSON..." Command="{Binding ImportJsonCommand}" />
                        <Separator />
                        <MenuItem Header="Просмотр справочника профессий" Command="{Binding OpenProfessionListCommand}" />
                        <Separator />
                        <MenuItem Header="Управление резервными копиями" Command="{Binding ManageBackupsCommand}" />
                    </MenuItem>
                    <MenuItem Header="Помощь">
                        <MenuItem Header="Проверить обновления..." Command="{Binding CheckUpdateCommand}" />
                        <Separator />
                        <MenuItem Header="О программе" Command="{Binding ShowAboutCommand}" />
                    </MenuItem>
                </Menu>

                <Grid Grid.Row="1">
                    <TabControl x:Name="MainTabControl"
                                Margin="12,10,12,8"
                                SelectedIndex="{Binding SelectedMainTabIndex, Mode=TwoWay}">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <Grid ClipToBounds="True">
                                    <ContentPresenter ContentSource="SelectedContent" />
                                </Grid>
                            </ControlTemplate>
                        </TabControl.Template>
                        <TabItem Header="Карточка СИЗ">
                            <ScrollViewer x:Name="CardScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="5">
                                    <GroupBox Header="ДАННЫЕ СОТРУДНИКА">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Style="{StaticResource SectionPanelBorder}">
                                                    <StackPanel>
                                                        <TextBlock Text="ЛИЧНЫЕ ДАННЫЕ"
                                                                   Style="{StaticResource SectionPanelTitle}" />
                                                        <TextBlock Text="Фамилия"
                                                                   Style="{StaticResource FieldCaption}" />
                                                        <TextBox Text="{Binding Card.LastName, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource FormTextBox}" />
                                                        <TextBlock Text="Имя"
                                                                   Style="{StaticResource FieldCaption}" />
                                                        <TextBox Text="{Binding Card.FirstName, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource FormTextBox}" />
                                                        <TextBlock Text="Отчество"
                                                                   Style="{StaticResource FieldCaption}" />
                                                        <TextBox Text="{Binding Card.MiddleName, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource FormTextBox}" />
                                                        <TextBlock Text="Пол"
                                                                   Style="{StaticResource FieldCaption}" />
                                                        <StackPanel Orientation="Horizontal" Margin="3,4,3,2">
                                                            <RadioButton Content="М" Margin="4,0"
                                                                         IsChecked="{Binding Card.Gender, Converter={StaticResource GenderConverter}, ConverterParameter=М}" />
                                                            <RadioButton Content="Ж" Margin="12,0,4,0"
                                                                         IsChecked="{Binding Card.Gender, Converter={StaticResource GenderConverter}, ConverterParameter=Ж}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="1" Style="{StaticResource SectionPanelBorder}">
                                                    <StackPanel>
                                                        <TextBlock Text="СЛУЖЕБНЫЕ ДАННЫЕ"
                                                                   Style="{StaticResource SectionPanelTitle}" />
                                                        <TextBlock Text="Номер карточки"
                                                                   Style="{StaticResource FieldCaption}" />
                                                        <TextBox Text="{Binding Card.CardNumber, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource FormTextBox}"
                                                                 ToolTip="Номер личной карточки" />
                                                        <TextBlock Text="Табельный номер"
                                                                   Style="{StaticResource FieldCaption}" />
                                                        <TextBox Text="{Binding Card.PersonnelNumber, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource FormTextBox}" />
                                                        <TextBlock Text="Подразделение"
                                                                   Style="{StaticResource FieldCaption}" />
                                                        <TextBox Text="{Binding Card.Department, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource FormTextBox}" />
                                                        <TextBlock Text="Дата поступления"
                                                                   Style="{StaticResource FieldCaption}" />
                                                        <DatePicker SelectedDate="{Binding Card.HireDate}"
                                                                    Margin="2" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <Border Style="{StaticResource SectionPanelBorder}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="200" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                                               Text="ПРОФЕССИЯ И НАЗНАЧЕНИЕ"
                                                               Style="{StaticResource SectionPanelTitle}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                                               Text="Профессия (должность)"
                                                               Style="{StaticResource FieldCaption}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                                               Text="Дата изменения"
                                                               Style="{StaticResource FieldCaption}" />

                                                    <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBox x:Name="ProfessionTextBox"
                                                                 Text="{Binding Card.ProfessionSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource FormTextBox}"
                                                                 ToolTip="Начните вводить название или номер профессии для поиска" />
                                                        <Popup IsOpen="{Binding Card.IsDropDownOpen, Mode=TwoWay}"
                                                               StaysOpen="False"
                                                               PlacementTarget="{Binding ElementName=ProfessionTextBox}"
                                                               Placement="Bottom"
                                                               Width="{Binding ActualWidth, ElementName=ProfessionTextBox}"
                                                               MaxHeight="300">
                                                            <Border Background="{StaticResource BrushSurface}"
                                                                    BorderBrush="{StaticResource BrushBorderStrong}"
                                                                    BorderThickness="1">
                                                                <ListBox ItemsSource="{Binding Card.FilteredProfessions}"
                                                                         DisplayMemberPath="DisplayName"
                                                                         SelectedItem="{Binding Card.SelectedProfession}"
                                                                         MaxHeight="290"
                                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                         MouseDoubleClick="ProfessionListBox_MouseDoubleClick"
                                                                         SelectionChanged="ProfessionListBox_SelectionChanged" />
                                                            </Border>
                                                        </Popup>
                                                    </Grid>

                                                    <DatePicker Grid.Row="2" Grid.Column="1"
                                                                SelectedDate="{Binding Card.ChangeDate}"
                                                                Margin="2" />
                                                </Grid>
                                            </Border>

                                            <Border Style="{StaticResource SectionPanelBorder}">
                                                <StackPanel>
                                                    <TextBlock Text="РАЗМЕРЫ И ЭКИПИРОВКА"
                                                               Style="{StaticResource SectionPanelTitle}" />
                                                    <WrapPanel>
                                                        <Border Style="{StaticResource SectionPanelBorder}" Width="150" Padding="10" Margin="0,0,8,8">
                                                            <StackPanel>
                                                                <TextBlock Text="Рост"
                                                                           Style="{StaticResource FieldCaption}"
                                                                           Margin="0,0,0,2" />
                                                                <TextBox Text="{Binding Card.HeightText, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{StaticResource FormTextBox}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Style="{StaticResource SectionPanelBorder}" Width="150" Padding="10" Margin="0,0,8,8">
                                                            <StackPanel>
                                                                <TextBlock Text="Одежда"
                                                                           Style="{StaticResource FieldCaption}"
                                                                           Margin="0,0,0,2" />
                                                                <TextBox Text="{Binding Card.ClothingSize, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{StaticResource FormTextBox}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Style="{StaticResource SectionPanelBorder}" Width="150" Padding="10" Margin="0,0,8,8">
                                                            <StackPanel>
                                                                <TextBlock Text="Обувь"
                                                                           Style="{StaticResource FieldCaption}"
                                                                           Margin="0,0,0,2" />
                                                                <TextBox Text="{Binding Card.ShoeSize, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{StaticResource FormTextBox}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Style="{StaticResource SectionPanelBorder}" Width="150" Padding="10" Margin="0,0,8,8">
                                                            <StackPanel>
                                                                <TextBlock Text="Головной убор"
                                                                           Style="{StaticResource FieldCaption}"
                                                                           Margin="0,0,0,2" />
                                                                <TextBox Text="{Binding Card.HeadwearSize, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{StaticResource FormTextBox}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Style="{StaticResource SectionPanelBorder}" Width="150" Padding="10" Margin="0,0,8,8">
                                                            <StackPanel>
                                                                <TextBlock Text="СИЗОД"
                                                                           Style="{StaticResource FieldCaption}"
                                                                           Margin="0,0,0,2" />
                                                                <TextBox Text="{Binding Card.RespiratorsSize, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{StaticResource FormTextBox}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Style="{StaticResource SectionPanelBorder}" Width="150" Padding="10" Margin="0,0,8,8">
                                                            <StackPanel>
                                                                <TextBlock Text="СИЗ рук"
                                                                           Style="{StaticResource FieldCaption}"
                                                                           Margin="0,0,0,2" />
                                                                <TextBox Text="{Binding Card.GlovesSize, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{StaticResource FormTextBox}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </GroupBox>

                                    <GroupBox Header="СИЗ ДЛЯ ДАННОЙ ПРОФЕССИИ">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="Позиции автоматически подставляются по выбранной профессии."
                                                               Foreground="{StaticResource BrushTextMuted}"
                                                               Margin="0,0,0,2" />
                                                    <TextBlock>
                                                        <Run Text="Всего позиций: " FontWeight="Bold" />
                                                        <Run Text="{Binding Card.SizItems.Count, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <WrapPanel Grid.Column="1">
                                                    <Button Content="+ Добавить СИЗ"
                                                            Command="{Binding Card.AddSizCommand}"
                                                            Style="{StaticResource SecondaryActionButton}"
                                                            ToolTip="Добавить новую запись СИЗ" />
                                                    <Button Content="Удалить СИЗ"
                                                            Command="{Binding Card.RemoveSizCommand}"
                                                            Style="{StaticResource SecondaryActionButton}"
                                                            ToolTip="Удалить выбранную запись СИЗ" />
                                                </WrapPanel>
                                            </Grid>

                                            <DataGrid Grid.Row="1"
                                                      ItemsSource="{Binding Card.SizItems}"
                                                      SelectedItem="{Binding Card.SelectedSizItem}"
                                                      MinHeight="220" MaxHeight="420"
                                                      CanUserSortColumns="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Тип СИЗ" Binding="{Binding Type}"
                                                                        Width="180" />
                                                    <DataGridTextColumn Header="Наименование СИЗ" Binding="{Binding Name}"
                                                                        Width="*" />
                                                    <DataGridTextColumn Header="Норма выдачи" Binding="{Binding Norm}"
                                                                        Width="120" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </GroupBox>

                                    <WrapPanel Margin="5,10"
                                               HorizontalAlignment="Left"
                                               MaxWidth="{Binding ActualWidth, ElementName=CardScrollViewer}">
                                        <Button Content="Новая карточка"
                                                Command="{Binding NewCardCommand}"
                                                Style="{StaticResource ActionButton}"
                                                ToolTip="Создать новую карточку (Ctrl+N)" />
                                        <Button Content="Сохранить"
                                                Command="{Binding Card.SaveCommand}"
                                                Style="{StaticResource ActionButton}"
                                                FontWeight="Bold"
                                                ToolTip="Сохранить карточку (Ctrl+S)" />
                                        <Button Command="{Binding Card.ExportDocxCommand}"
                                                Style="{StaticResource SecondaryActionButton}"
                                                ToolTip="Экспорт в Word документ">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="/Resources/Icons/export-docx.png"
                                                       Style="{StaticResource ExportIconImage}" />
                                                <TextBlock Text="Экспорт в DOCX"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding Card.ExportPdfCommand}"
                                                Style="{StaticResource SecondaryActionButton}"
                                                ToolTip="Экспорт в PDF документ">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="/Resources/Icons/export-pdf.png"
                                                       Style="{StaticResource ExportIconImage}" />
                                                <TextBlock Text="Экспорт в PDF"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding Card.ExportExcelCommand}"
                                                Style="{StaticResource SecondaryActionButton}"
                                                ToolTip="Экспорт в Excel файл">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="/Resources/Icons/export-excel.png"
                                                       Style="{StaticResource ExportIconImage}" />
                                                <TextBlock Text="Экспорт в Excel"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Дерматологические СИЗ">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="260" />
                                    <ColumnDefinition Width="3*" MinWidth="320" />
                                </Grid.ColumnDefinitions>

                                <GroupBox Grid.ColumnSpan="2" Header="ПОДБОР ДЕРМАТОЛОГИЧЕСКИХ СИЗ ПО ВИДАМ РАБОТ">
                                    <StackPanel>
                                        <TextBlock Text="Отметьте один или несколько видов работ. Справа будет собрана таблица только с необходимыми средствами и нормами."
                                                   TextWrapping="Wrap" Margin="0,0,0,6" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Style="{StaticResource SectionPanelBorder}" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Dermatological.SelectedCount, Mode=OneWay}"
                                                               Style="{StaticResource StatValueText}" />
                                                    <TextBlock Text="Выбрано видов работ"
                                                               Style="{StaticResource StatCaptionText}" />
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1" Style="{StaticResource SectionPanelBorder}" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Dermatological.RequirementCount, Mode=OneWay}"
                                                               Style="{StaticResource StatValueText}" />
                                                    <TextBlock Text="Позиции в итоговой таблице"
                                                               Style="{StaticResource StatCaptionText}" />
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="2" Style="{StaticResource SectionPanelBorder}" Margin="0">
                                                <StackPanel>
                                                    <TextBlock Text="Как это работает"
                                                               Style="{StaticResource SectionPanelTitle}"
                                                               Margin="0,0,0,4" />
                                                    <TextBlock Text="Слева выбираются виды работ, справа автоматически собирается сводная таблица средств и норм без ручного заполнения."
                                                               Foreground="{StaticResource BrushTextMuted}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Grid.Row="1" Grid.Column="0" Header="ВИДЫ РАБОТ">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top"
                                                   Text="Отметьте подходящие виды работ для текущего сотрудника."
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   Margin="0,0,0,8"
                                                   TextWrapping="Wrap" />
                                        <ListBox ItemsSource="{Binding Dermatological.Rows}"
                                                 SelectedItem="{Binding Dermatological.SelectedRow}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"
                                                              Margin="2,4">
                                                        <TextBlock Text="{Binding WorkType}"
                                                                   TextWrapping="Wrap" />
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </GroupBox>

                                <GroupBox Grid.Row="1" Grid.Column="1" Header="СФОРМИРОВАННАЯ ТАБЛИЦА">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top"
                                                   Text="Готовая сводная таблица для экспорта и печати."
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   Margin="0,0,0,8"
                                                   TextWrapping="Wrap" />
                                        <Grid DockPanel.Dock="Top" Background="#E8EEF7" Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <Border BorderBrush="#B8C7D9" BorderThickness="1" Padding="5">
                                                <TextBlock Text="Необходимое средство" FontWeight="Bold" TextAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="1" BorderBrush="#B8C7D9" BorderThickness="0,1,1,1" Padding="5">
                                                <TextBlock Text="Норма" FontWeight="Bold" TextAlignment="Center" />
                                            </Border>
                                        </Grid>

                                        <ListBox ItemsSource="{Binding Dermatological.Requirements}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Border Background="#DDEBF7" BorderBrush="#B8C7D9" BorderThickness="1" Padding="6">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding ProductType}"
                                                                       FontWeight="Bold"
                                                                       TextWrapping="Wrap" />
                                                        </Border>

                                                        <Grid>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="120" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border BorderBrush="#E0E0E0" BorderThickness="1,0,1,1" Padding="5">
                                                                <TextBlock Text="{Binding ProductType}" TextWrapping="Wrap" />
                                                            </Border>
                                                            <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1" Padding="5">
                                                                <TextBlock Text="{Binding Norm}" TextWrapping="Wrap" TextAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </GroupBox>

                                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <WrapPanel Grid.Column="0">
                                        <Button Content="Выбрать все"
                                                Command="{Binding Dermatological.SelectAllCommand}"
                                                Style="{StaticResource SecondaryActionButton}" />
                                        <Button Content="Снять выбор"
                                                Command="{Binding Dermatological.ClearSelectionCommand}"
                                                Style="{StaticResource SecondaryActionButton}" />
                                        <Button Content="Сбросить"
                                                Command="{Binding Dermatological.ResetDefaultsCommand}"
                                                Style="{StaticResource SecondaryActionButton}" />
                                    </WrapPanel>

                                    <WrapPanel Grid.Column="1">
                                        <Button Command="{Binding Dermatological.ExportExcelCommand}"
                                                Style="{StaticResource SecondaryActionButton}"
                                                FontWeight="Bold">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="/Resources/Icons/export-excel.png"
                                                       Style="{StaticResource ExportIconImage}" />
                                                <TextBlock Text="Экспорт в Excel"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding Dermatological.ExportPdfCommand}"
                                                Style="{StaticResource SecondaryActionButton}"
                                                FontWeight="Bold">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="/Resources/Icons/export-pdf.png"
                                                       Style="{StaticResource ExportIconImage}" />
                                                <TextBlock Text="Экспорт в PDF"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <Border Background="#80000000"
                            Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}">
                        <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                                Background="White" Padding="30" CornerRadius="10">
                            <StackPanel MinWidth="300">
                                <TextBlock Text="Импорт справочника..." FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <ProgressBar Height="20" IsIndeterminate="True" Margin="0,0,0,5" />
                                <TextBlock Text="{Binding StatusBarText}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

                <StatusBar Grid.Row="2">
                    <StatusBarItem>
                        <TextBlock Text="{Binding StatusBarText}" />
                    </StatusBarItem>
                    <StatusBarItem HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Card.StatusMessage}" Foreground="Gray" />
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </Grid>
    </Border>
</Window>
