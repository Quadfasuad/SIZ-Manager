<Window x:Class="SizManager.Views.EmployeeListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список карточек сотрудников"
        Width="750" Height="500"
        MinWidth="500" MinHeight="350"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="10">
        <!-- Search -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BrushSurfaceMuted}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="ПОИСК КАРТОЧЕК"
                               Style="{StaticResource SectionPanelTitle}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Width="320"
                             ToolTip="Поиск по ФИО, табельному номеру или профессии" />
                </StackPanel>

                <Border Grid.Column="1"
                        Style="{StaticResource SectionPanelBorder}"
                        Padding="12"
                        Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalCount, Mode=OneWay}"
                                   Style="{StaticResource StatValueText}" />
                        <TextBlock Text="Найдено карточек"
                                   Style="{StaticResource StatCaptionText}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Открыть" Padding="12,6" Margin="4,0"
                    IsDefault="True" Click="OpenButton_Click"
                    ToolTip="Открыть выбранную карточку" />
            <Button Content="Удалить" Padding="12,6" Margin="4,0"
                    Command="{Binding DeleteSelectedCommand}"
                    ToolTip="Удалить выбранную карточку" />
            <Button Content="Закрыть" Padding="12,6" Margin="4,0"
                    IsCancel="True" Click="CloseButton_Click" />
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid ItemsSource="{Binding Employees}"
                  SelectedItem="{Binding SelectedEmployee}"
                  IsReadOnly="True"
                  MouseDoubleClick="DataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*" />
                <DataGridTextColumn Header="Профессия" Binding="{Binding ProfessionName}" Width="200" />
                <DataGridTextColumn Header="Таб. №" Binding="{Binding PersonnelNumber}" Width="100" />
                <DataGridTextColumn Header="Подразделение" Binding="{Binding Department}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
