<Window x:Class="SizManager.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе"
        Width="450" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <StackPanel HorizontalAlignment="Center" Margin="30">
        <TextBlock Text="СИЗ Менеджер" FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,5" />
        <TextBlock x:Name="VersionText" FontSize="14"
                   HorizontalAlignment="Center" Foreground="Gray" Margin="0,0,0,20" />

        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,15">
            Программа для автоматизации заполнения личных карточек
            учёта выдачи средств индивидуальной защиты (СИЗ)
        </TextBlock>

        <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="Gray">
            На основе Приказа Минтруда РФ от 29.10.2021 №767н
            "Об утверждении Единых типовых норм выдачи СИЗ"
        </TextBlock>

        <Separator Margin="0,15" />

        <TextBlock Text=".NET 8.0 | WPF | SQLite" FontSize="11"
                   HorizontalAlignment="Center" Foreground="Gray" />

        <Button Content="Закрыть" Padding="20,6" Margin="0,15,0,0"
                HorizontalAlignment="Center" IsCancel="True" />
    </StackPanel>
</Window>
