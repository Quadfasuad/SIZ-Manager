<Window x:Class="SizManager.Views.ProfessionListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справочник профессий"
        Width="900" Height="600"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="10">
        <!-- Search -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="300" Padding="4,3"
                     ToolTip="Поиск по названию или номеру профессии" />
            <TextBlock VerticalAlignment="Center" Margin="15,0,0,0">
                <Run Text="Всего профессий: " />
                <Run Text="{Binding TotalCount, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <!-- Close button -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Закрыть" Padding="12,6" IsCancel="True" />
        </StackPanel>

        <!-- Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Professions list -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Профессии:" FontWeight="Bold" Margin="0,0,0,5" />
                <DataGrid ItemsSource="{Binding Professions}"
                          SelectedItem="{Binding SelectedProfession}"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Number}" SortMemberPath="NumberAsInt" Width="60" />
                        <DataGridTextColumn Header="Название профессии" Binding="{Binding Name}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

            <!-- SIZ list for selected profession -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="5,0,0,5">
                    <Run Text="СИЗ" />
                    <Run Text="{Binding SelectedProfession.Name, Mode=OneWay, FallbackValue=''}" />
                    <Run Text=": " />
                    <Run Text="{Binding SizItems.Count, Mode=OneWay, FallbackValue=0}" />
                </TextBlock>
                <DataGrid ItemsSource="{Binding SizItems}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Тип СИЗ" Binding="{Binding Type}" Width="200" />
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Норма" Binding="{Binding Norm}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
